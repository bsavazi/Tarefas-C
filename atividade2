#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct FILA {
    float valor;
    struct FILA *proximo;
} Fila;

void push(Fila **f, int valor) {
    Fila *novo;

    novo = malloc(sizeof(Fila));
    if(!novo) {
        printf("Erro de alocação.\n");
        exit(-1);
    }
    novo->valor = valor;
    novo->proximo = *f;
    *f = novo;
}

int pop(Fila **f) {
    Fila *p;
    int val;

    if(*f == NULL) return -99999;
    p = *f;
    *f = p->proximo;

    val = p->valor;
    free(p);
    return val;
}

int peek(Fila *f) {
    if(f == NULL) return -99999;
    return f->valor;
}

int main(){

    Fila *pilha;

    pilha = NULL;
    push(&pilha, 10);
    push(&pilha, 20);
    push(&pilha, 30);

    printf("Topo: %d\n", peek(pilha));
    printf("Retirado: %d\n", pop(&pilha));
    printf("Retirado: %d\n", pop(&pilha));

    push(&pilha, 40);

    while(pilha)
        printf("Retirado: %d\n", pop(&pilha));
}

