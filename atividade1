#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int comparar(const void *a, const void *b) {
    double x = *(const double *)a;
    double y = *(const double *)b;
    return (x > y) - (x < y);
}

int main(void) {
    int n;

    printf("Quantos números na sua série (N): ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 1;
    }

    double *valores = malloc(n * sizeof(double));
    if (valores == NULL) {
        return 1;
    }

    printf("Entre com números:\n");
    double soma = 0.0;
    for (int i = 0; i < n; i++) {
        printf("> ");
        if (scanf("%lf", &valores[i]) != 1) {
            free(valores);
            return 1;
        }
        soma += valores[i];
    }

    double media = soma / n;

    double acumulado = 0.0;
    for (int i = 0; i < n; i++) {
        double d = valores[i] - media;
        acumulado += d * d;
    }
    double desvio = sqrt(acumulado / n);

    qsort(valores, n, sizeof(double), comparar);

    double mediana;
    if (n % 2 == 1) {
        mediana = valores[n / 2];
    } else {
        mediana = (valores[n / 2 - 1] + valores[n / 2]) / 2.0;
    }

    printf("Valor mínimo: %.15g\n", valores[0]);
    printf("Valor Máximo: %.15g\n", valores[n - 1]);
    printf("Média: %.15g\n", media);
    printf("Mediana: %.15g\n", mediana);
    printf("Desvio padrão: %.15g\n", desvio);

    free(valores);
    return 0;
}
